APP_ENV=production
APP_NAME=Education OS
API_V1_PREFIX=/api/v1

# Alembic imports application settings, but this secret is not used for DB ownership.
SECRET_KEY=REPLACE_WITH_SECRET_AT_LEAST_32_CHARACTERS

DATABASE_URL=postgresql+psycopg://education_app:REPLACE_RUNTIME_PASSWORD@postgres.internal:5432/education_os
OWNER_DATABASE_URL=postgresql+psycopg://education_owner:REPLACE_MIGRATION_PASSWORD@postgres.internal:5432/education_os

ACCESS_TOKEN_EXPIRE_MINUTES=480
RELEASE_ID=v1.0.0-rc7
PUBLIC_BASE_URL=https://education.example.org
FRONTEND_REQUIRED_FOR_READINESS=true
SLOW_REQUEST_MS=1000

# This migration environment is short-lived and must not be reused by the
# long-running application process.
