APP_ENV=development
APP_NAME=Education OS
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-real-environments

# Runtime connection: application role, RLS enforced
DATABASE_URL=postgresql+psycopg://education_app:education_app_dev@localhost:5432/education_os

# Migration/admin connection: table owner
OWNER_DATABASE_URL=postgresql+psycopg://education_owner:education_owner_dev@localhost:5432/education_os

ACCESS_TOKEN_EXPIRE_MINUTES=480
