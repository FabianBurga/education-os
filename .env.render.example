APP_ENV=staging
APP_NAME=Education OS
API_V1_PREFIX=/api/v1
SECRET_KEY=<generate-a-unique-32-plus-character-secret>
DATABASE_URL=<restricted-education_app-postgresql-connection>
ACCESS_TOKEN_EXPIRE_MINUTES=480
RELEASE_ID=<exact-deployment-commit-sha>
PUBLIC_BASE_URL=https://<render-service>.onrender.com
FRONTEND_REQUIRED_FOR_READINESS=true
SLOW_REQUEST_MS=1000
EDUCATION_OS_DEMO_MODE=true
EDUCATION_OS_DEMO_SYNTHETIC_ONLY=true
EDUCATION_OS_DEMO_ORGANIZATION_ID=<synthetic-demo-organization-uuid>
EDUCATION_OS_DEMO_INSTITUTION_ID=<synthetic-demo-institution-uuid>
EDUCATION_OS_DEMO_PRINCIPALS={"RECTOR":"<uuid>","COORDINATION":"<uuid>","TEACHER":"<uuid>","STUDENT":"<uuid>","GUARDIAN":"<uuid>"}
EDUCATION_OS_DEMO_ACCESS_CODE=<deployment-secret-at-least-24-characters>
